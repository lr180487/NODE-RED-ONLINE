
# ==========================================
# APPKATA - GITIGNORE
# ==========================================

# 1. VARIABLES DE ENTORNO Y SECRETOS
.env
.env.*
!.env.example
!.env.template
!.env.sample

*.pem
*.key
*.p12
*.pfx
*.secret
secrets/
credentials/
certs/private/

# 2. NODE.JS / NODE-RED
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Node-RED credentials and sensitive runtime data
flows_cred.json
*_cred.json
.config.runtime.json
.context/
context/
.cache/

# 3. DATOS DE NODE-RED
# Conservar los flujos y configuraciones versionables
# No excluir data/ completo: puede contener flows.json
data/flows_cred.json
data/*_cred.json
data/.config.runtime.json
data/context/
data/.context/
data/.cache/
data/node_modules/

# 4. ARCHIVOS TEMPORALES
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

.DS_Store
Thumbs.db
desktop.ini

# 5. PYTHON / FASTAPI
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# 6. EDITORES Y CONFIGURACIONES LOCALES
.vscode/
.idea/
*.code-workspace
.local/

# 7. DOCKER
*.pid
docker-data/
docker-volumes/
.docker/

# 8. BASES DE DATOS LOCALES
*.sqlite
*.sqlite3
*.db
data/private/
storage/private/

# 9. CERTIFICADOS Y SEGURIDAD
private/
certificates/private/
*.csr

# 10. BUILD Y DISTRIBUCIÓN
dist/
build/
out/
coverage/

# 11. SISTEMA OPERATIVO
$RECYCLE.BIN/
System Volume Information/

# 12. RENDER / FLY.IO
.render/
.fly/

# ==========================================
# ARCHIVOS QUE DEBEN CONSERVARSE
# ==========================================
# package.json
# package-lock.json
# settings.js
# flows.json
# flows/*.json
# Dockerfile
# docker-compose.yml
# fly.toml
# .env.example
# README.md
